APP_NAME=Paymenter
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paymenter
DB_USERNAME=paymenter
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------------
# Payment credentials
#--------------------------------------------------------------------------
# prod (default) — gateways use the keys entered in Admin → Gateways.
# dev            — gateways use the sandbox keys below instead.
#
# Only keys with a value take effect; blank ones fall through to the stored
# value, so a single field can be overridden on its own. Never commit real
# values here — put them in .env, which is gitignored.
#
# See docs/PAYMENT-KEYS.md for where each credential comes from.
PAYMENT_MODE=prod

# Stripe — free, instant: https://dashboard.stripe.com/test/apikeys
PAYMENT_DEV_STRIPE_SECRET_KEY=
PAYMENT_DEV_STRIPE_PUBLISHABLE_KEY=
PAYMENT_DEV_STRIPE_WEBHOOK_SECRET=

# CoinPayments — free account, test buys use LTCT (Litecoin testnet)
PAYMENT_DEV_COINPAYMENTS_MERCHANT_ID=
PAYMENT_DEV_COINPAYMENTS_PUBLIC_KEY=
PAYMENT_DEV_COINPAYMENTS_PRIVATE_KEY=
PAYMENT_DEV_COINPAYMENTS_IPN_SECRET=
PAYMENT_DEV_COINPAYMENTS_RECEIVE_CURRENCY=LTCT
PAYMENT_DEV_COINPAYMENTS_TEST_MODE=1

# Cryptomus — keys issued only after their team approves an application
PAYMENT_DEV_CRYPTOMUS_MERCHANT_ID=
PAYMENT_DEV_CRYPTOMUS_PAYMENT_API_KEY=

# Binance Pay — sandbox access must be requested from Binance Merchant Ops
PAYMENT_DEV_BINANCE_API_KEY=
PAYMENT_DEV_BINANCE_API_SECRET=
PAYMENT_DEV_BINANCE_PAY_CURRENCY=
PAYMENT_DEV_BINANCE_TEST_MODE=1
PAYMENT_DEV_BINANCE_SANDBOX_URL=